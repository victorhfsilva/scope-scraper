# Credenciais da API do HackerOne (https://hackerone.com/settings/api_token)
HACKERONE_USERNAME=
HACKERONE_TOKEN=

# Webhook do Discord usado pelo notify/notify_diff.sh
DISCORD_WEBHOOK=

# Tempo de espera, em horas, entre o fim do Bugcrowd e o inicio do HackerOne
H1_DELAY_HOURS=3

# Timeout de cada crawl (segundos). Padrao: 6 horas
JOB_TIMEOUT_SECONDS=21600

# Agendamento cron (minuto hora dia mes dia-da-semana) - horario do container/TZ
PIPELINE_CRON=0 2 * * *

TZ=America/Sao_Paulo

# UID/GID do usuario do host que sera dono dos arquivos em ./data
PUID=1000
PGID=1000
